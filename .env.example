PORT=3020
TZ=Europe/Sarajevo
# tajni ključ za prijavu (promijeni u nešto dugačko i nasumično)
SESSION_SECRET=promijeni-me
# putanja do baze i slika
DB_PATH=./data/delic.db
UPLOADS_DIR=./data/uploads
# Ako slika nije lokalno, preusmjeri na ovu adresu ({id} se zamjenjuje id-em slike). Prazno = ne preusmjeravaj.
IMG_FALLBACK_URL=
# Pozadinski poslovi (OLX). 0 = isključeno
SCHEDULER=1
# Rezervne kopije baze (svaki dan u 03:10): folder i koliko dana čuvati
BACKUP_DIR=./data/backups
BACKUP_KEEP=10
# Javni API za webshop (prazno = isključen)
PUBLIC_API_KEY=
# Veza sa webshopom (delicauto-shop): isti ključ upisati u .env webshopa kao APP_API_KEY
SHOP_API_KEY=
